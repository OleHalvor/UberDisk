<Project Sdk="Microsoft.NET.Sdk">
  <!-- Times full drive scans at several thread counts. Usage: dotnet run -c Release, then the drive root (C:\) as the first argument -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/UberDisk.Core/UberDisk.Core.csproj" />
  </ItemGroup>
</Project>
