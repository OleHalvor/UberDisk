<Application x:Class="UberDisk.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Dark theme (the only theme). -->
      <Color x:Key="BgColor">#16181D</Color>
      <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
      <SolidColorBrush x:Key="RailBg" Color="#1A1C21" />
      <SolidColorBrush x:Key="CardBg" Color="#1F2127" />
      <SolidColorBrush x:Key="CardHover" Color="#252830" />
      <SolidColorBrush x:Key="CardBorder" Color="#2C2F37" />
      <SolidColorBrush x:Key="Divider" Color="#262931" />
      <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
      <SolidColorBrush x:Key="AccentButton" Color="#2F6FDE" />
      <SolidColorBrush x:Key="AccentButtonHover" Color="#3D7DEB" />
      <SolidColorBrush x:Key="Text" Color="#E8EAED" />
      <SolidColorBrush x:Key="TextDim" Color="#9AA0A9" />
      <SolidColorBrush x:Key="TextFaint" Color="#6B717B" />
      <SolidColorBrush x:Key="BarTrack" Color="#33363E" />
      <SolidColorBrush x:Key="BarBlue" Color="#4C8DF6" />
      <SolidColorBrush x:Key="BarOrange" Color="#F28C28" />
      <SolidColorBrush x:Key="BarRed" Color="#E5484D" />
      <SolidColorBrush x:Key="ChipBg" Color="#2A2D35" />
      <SolidColorBrush x:Key="PopupBg" Color="#22252B" />
      <SolidColorBrush x:Key="PopupBorder" Color="#3A3E47" />
      <SolidColorBrush x:Key="MenuHover" Color="#30343D" />

      <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
      <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

      <!-- Small borderless icon button (nav arrows). -->
      <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="Transparent" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="{StaticResource ChipBg}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="#4A4F58" />
                  <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Breadcrumb part. -->
      <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="Background" Value="{StaticResource CardBg}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="CrumbButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="{StaticResource ChipBg}" />
                </Trigger>
                <Trigger Property="Tag" Value="current">
                  <Setter TargetName="b" Property="Background" Value="{StaticResource ChipBg}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Blue primary button (Rescan). Tag="stop" turns it grey (Stop). -->
      <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="{StaticResource AccentButton}" CornerRadius="6"
                      BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="{StaticResource AccentButtonHover}" />
                </Trigger>
                <Trigger Property="Tag" Value="stop">
                  <Setter TargetName="b" Property="Background" Value="{StaticResource ChipBg}" />
                  <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource PopupBorder}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="b" Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Dark context menu. -->
      <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ContextMenu">
              <Border Background="{StaticResource PopupBg}" BorderBrush="{StaticResource PopupBorder}"
                      BorderThickness="1" CornerRadius="8" Padding="6" MinWidth="240">
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="MenuItem">
              <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="10,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" />
                  <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                  <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0"
                             Foreground="{StaticResource TextFaint}" FontSize="12" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                  <Setter TargetName="b" Property="Background" Value="{StaticResource MenuHover}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{StaticResource Text}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="Separator">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Separator">
              <Border Height="1" Margin="4,4" Background="{StaticResource PopupBorder}" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Thin dark scroll bars (the default ones are light grey). -->
      <ControlTemplate x:Key="ThumbTemplate" TargetType="Thumb">
        <Border CornerRadius="3" Background="#3A3E47" />
      </ControlTemplate>
      <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                  <Track.Thumb>
                    <Thumb Template="{StaticResource ThumbTemplate}" />
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="6" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                  <Grid Background="Transparent">
                    <Track x:Name="PART_Track">
                      <Track.Thumb>
                        <Thumb Template="{StaticResource ThumbTemplate}" />
                      </Track.Thumb>
                    </Track>
                  </Grid>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource PopupBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource PopupBorder}" />
      </Style>

      <Style x:Key="Key" TargetType="Border">
        <Setter Property="BorderBrush" Value="#454953" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Background" Value="#20232A" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
